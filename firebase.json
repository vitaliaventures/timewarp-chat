{
  "hosting": {
    "public": ".",
    "cleanUrls": false,
    "trailingSlash": false,

    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],

    "headers": [
      {
        "source": "/sitemap.xml",
        "headers": [
          { "key": "Content-Type", "value": "application/xml" }
        ]
      },
      {
        "source": "/robots.txt",
        "headers": [
          { "key": "Content-Type", "value": "text/plain" }
        ]
      }
    ],

    "rewrites": [
      {
        "source": "/r/**",
        "destination": "/index.html"
      },
      {
        "source": "/p/**",
        "destination": "/p/private-anonymous-chat.html"
      },
      {
        "source": "/anonymous-chat-without-registration.html",
        "destination": "/anonymous-chat-without-registration.html"
      }
    ]
  }
}
