{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Alt-Svc",
            "value": "h3=\":0\"; ma=0"
          },
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      }
    ],
    "rewrites": [
  {
    "source": "/sitemap.xml",
    "destination": "/sitemap.xml"
  },
  {
    "source": "/robots.txt",
    "destination": "/robots.txt"
  },
  {
    "source": "/anonymous-chat-without-registration.html",
    "destination": "/anonymous-chat-without-registration.html"
  },
  {
    "source": "**",
    "destination": "/index.html"
  }
]

  }
}
