{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/private-anonymous-chat.html",
        "destination": "/p/private-anonymous-chat.html"
      },
      {
        "source": "/anonymous-chat.html",
        "destination": "/anonymous-chat.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
