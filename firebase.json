{
  "hosting": {
    "public": "public",

    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],

    "headers": [
      {
        "source": "**/*.js",
        "headers": [
          { "key": "Content-Type", "value": "application/javascript" }
        ]
      },
      {
        "source": "**/*.css",
        "headers": [
          { "key": "Content-Type", "value": "text/css" }
        ]
      }
    ],

    "rewrites": [
      {
        "source": "!**/*.@(js|css|png|jpg|jpeg|gif|svg|ico|xml|txt)",
        "destination": "/index.html"
      }
    ]
  }
}
