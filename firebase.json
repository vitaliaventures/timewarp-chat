{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "index, follow"
          }
        ]
      }
    ],
    "rewrites": [
      { "source": "/r/**", "destination": "/index.html" },
      { "source": "**", "destination": "/index.html" }
    ]
  }
}
