{
  "hosting": {
    "public": "public",

    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],

    "headers": [
      {
        "source": "**/*.js",
        "headers": [
          { "key": "Content-Type", "value": "application/javascript" }
        ]
      },
      {
        "source": "**/*.css",
        "headers": [
          { "key": "Content-Type", "value": "text/css" }
        ]
      }
    ],

    "rewrites": [
      {
        "source": "/sitemap.xml",
        "destination": "/sitemap.xml"
      },
      {
        "source": "/robots.txt",
        "destination": "/robots.txt"
      },

      /* 🔥 SEO pages deben cargarse directas */
      {
        "source": "/**/*.html",
        "destination": "/$1"
      },

      /* 🔥 todo lo demás va al chat SPA */
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
